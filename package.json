{
  "name": "zeffree-github-io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive control room for zeffree's GitHub Pages projects.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:offline": "node scripts/build.mjs --offline",
    "serve": "http-server . -a 127.0.0.1 -p 8080 -c-1",
    "previews": "node scripts/capture-previews.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check:budgets": "node scripts/check-budgets.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "http-server": "14.1.1",
    "sharp": "0.35.4"
  }
}
